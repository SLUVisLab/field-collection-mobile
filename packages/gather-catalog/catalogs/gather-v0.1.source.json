{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gather.slu.edu/a2ui/catalogs/v0.1.source.json",
  "catalogId": "https://gather.slu.edu/a2ui/catalogs/v0.1.json",
  "title": "Gather Instrument Catalog",
  "description": "Gather-specific components for field measurement instruments.",
  "components": {
    "GatherCapture": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "GatherCapture"
            },
            "phase": {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            "statePath": {
              "type": "string"
            }
          },
          "required": ["component", "phase", "statePath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ImageOverlay": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "ImageOverlay"
            },
            "image": {
              "$ref": "common_types.json#/$defs/DynamicValue"
            },
            "segmentation": {
              "$ref": "common_types.json#/$defs/DynamicValue"
            }
          },
          "required": ["component"]
        }
      ],
      "unevaluatedProperties": false
    },
    "OutputReview": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "OutputReview"
            },
            "data": {
              "$ref": "common_types.json#/$defs/DynamicValue"
            },
            "display": {
              "$ref": "common_types.json#/$defs/DynamicValue"
            }
          },
          "required": ["component"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ProcessingView": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "ProcessingView"
            },
            "phase": {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            "image": {
              "$ref": "common_types.json#/$defs/DynamicValue"
            }
          },
          "required": ["component", "phase"]
        }
      ],
      "unevaluatedProperties": false
    },
    "InstrumentError": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "InstrumentError"
            },
            "phase": {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            "error": {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            "statePath": {
              "type": "string"
            }
          },
          "required": ["component", "phase", "statePath"]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/GatherCapture"
        },
        {
          "$ref": "#/components/ImageOverlay"
        },
        {
          "$ref": "#/components/OutputReview"
        },
        {
          "$ref": "#/components/ProcessingView"
        },
        {
          "$ref": "#/components/InstrumentError"
        }
      ]
    }
  }
}
