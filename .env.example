# Gather environment variables. Copy to `.env` (gitignored) and fill in real
# values, or `source` a local env file for CLI/test runs. Never commit secrets.

# --- Legacy Gather backend (Firebase / Gather Hub) ---
EXPO_PUBLIC_FIREBASE_KEY="API_KEY_HERE"
EXPO_PUBLIC_API_BASE_URL="https://openfieldworks.org/api"
EXPO_PUBLIC_GATHER_HUB_API_KEY="API_KEY_HERE"

# --- Native build-time config (referenced by app.config.js) ---
# Paths to the Firebase config files, injected at build time.
GOOGLE_SERVICES_IOS="./GoogleService-Info.plist"
GOOGLE_SERVICES_ANDROID="./google-services.json"
GOOGLE_MAPS_IOS_API_KEY="API_KEY_HERE"
GOOGLE_MAPS_ANDROID_API_KEY="API_KEY_HERE"

# --- ODK Central (used by odk-central-client live tests + runtime) ---
ODK_CENTRAL_URL="https://central.example.org"
ODK_CENTRAL_PROJECT_ID="1"
ODK_CENTRAL_FORM_ID="my_form"
ODK_CENTRAL_APP_USER_TOKEN="APP_USER_TOKEN_HERE"
ODK_CENTRAL_EMAIL="user@example.org"
ODK_CENTRAL_PASSWORD="PASSWORD_HERE"
