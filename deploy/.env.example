# Copy to deploy/.env and edit for your host, then run: docker compose up -d --build
#
# Public hostnames (must resolve to this server's IP via DNS A/AAAA records).
RENDERER_DOMAIN=renderer.openfieldworks.com
CENTRAL_DOMAIN=central.openfieldworks.com

# Loopback ports the reverse proxy forwards to.
# RENDERER_UPSTREAM_PORT is where this stack publishes the renderer container.
# CENTRAL_UPSTREAM_PORT must match the host port ODK Central's nginx is bound to
# (see deploy/central/docker-compose.override.yml).
RENDERER_UPSTREAM_PORT=8080
CENTRAL_UPSTREAM_PORT=8081

# Email used for Let's Encrypt registration / expiry notices.
ACME_EMAIL=administrator@openfieldworks.com
