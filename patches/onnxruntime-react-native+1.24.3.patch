+            newSrc: '      packages.add(new OnnxruntimePackage());',
+            tag: 'onnxruntime-react-native-package',
+            anchor: /^\s*List<ReactPackage>\s+packages\s*=\s*new PackageList\(this\)\.getPackages\(\);\s*$/m,
+            offset: 1,
+            comment: '//',
+          }).contents;
